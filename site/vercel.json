{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],

  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/testosterone-apexmd", "destination": "/testosterone", "permanent": true },
    { "source": "/mens-hormones", "destination": "/testosterone", "permanent": true },
    { "source": "/weight-loss", "destination": "/glp-1-program", "permanent": true },
    { "source": "/weight-loss-2", "destination": "/glp-1-program", "permanent": true },
    { "source": "/mens-optimal-health-new", "destination": "/mens-optimal-health", "permanent": true },
    { "source": "/mens-optimal-health-new1", "destination": "/mens-optimal-health", "permanent": true },
    { "source": "/womens-optimal-health-new", "destination": "/womens-optimal-health", "permanent": true },
    { "source": "/genetics-old", "destination": "/genetics", "permanent": true },
    { "source": "/apex-md-ai-old", "destination": "/apex-md-ai", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/home-old", "destination": "/", "permanent": true },
    { "source": "/home-new", "destination": "/", "permanent": true },
    { "source": "/home-new-2", "destination": "/", "permanent": true },
    { "source": "/home-page-2", "destination": "/", "permanent": true },
    { "source": "/home-page-2-2", "destination": "/", "permanent": true }
  ]
}
